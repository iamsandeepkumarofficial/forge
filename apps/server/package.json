{
  "name": "@forge/server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "db:generate": "pnpm --filter @forge/db db:generate",
    "db:migrate": "pnpm --filter @forge/db db:migrate",
    "test": "tsx --experimental-test-module-mocks --test \"src/**/*.test.ts\"",
    "test:contract": "tsx --experimental-test-module-mocks --test \"src/api/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/credential-providers": "^3.699.0",
    "@aws-sdk/types": "^3.699.0",
    "@modelcontextprotocol/sdk": "^1.17.1",
    "@octokit/rest": "^22.0.0",
    "@forge/tools": "workspace:*",
    "@forge/agents": "workspace:*",
    "@forge/core": "workspace:*",
    "@forge/skills": "workspace:*",
    "@forge/db": "workspace:*",
    "@forge/workflows": "workspace:*",
    "@temporalio/client": "^1.11.6",
    "@types/multer": "^1.4.12",
    "@types/unzipper": "^0.10.11",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.38.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "simple-git": "^3.28.0",
    "tar-stream": "^3.1.7",
    "unzipper": "^0.12.3",
    "@forge/preview-plane": "workspace:*"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/unzipper": "^0.10.11",
    "tsx": "^4.20.5"
  }
}

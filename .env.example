# Shared between tool-runner (@forge/server) and orchestrator.
# Prefer FORGE_POC_TOKEN. Desktop (Tauri) supervisor injects a random
# high-entropy bearer token per launch — do not commit a shared secret.
FORGE_POC_TOKEN=change-me-local-only

# Listen address (default 127.0.0.1 for local-first safety).
# FORGE_BIND_HOST=127.0.0.1
# FORGE_BIND_LOOPBACK=1

# Web UI catalog user (also send as X-Forge-User-Email from the browser).
FORGE_WEB_UI_USER_EMAIL=dev@local.forge

# Conversation catalog (@forge/server).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forge

# Connected git clones. Default: ~/.forge/repositories
# CODEBASE_ROOT=/custom/path/repositories

# Per-chat worktrees (sibling of repositories/). Default: ~/.forge/.sessions
# FORGE_SESSIONS_ROOT=/custom/path/.sessions

# Tool plane / API base (server + CLI + orchestrator).
TOOL_RUNNER_URL=http://127.0.0.1:4000
# CLI can also set FORGE_API_URL (defaults to TOOL_RUNNER_URL).
# FORGE_API_URL=http://127.0.0.1:4000

# Interactive chat + board pipeline LLM keys (used by orchestrator activities).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI-compatible endpoint (OpenRouter, LM Studio, vLLM, etc.) —
# select "OpenAI-compatible" as provider in the UI.
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
# Legacy aliases (still read): CUSTOM_BASE_URL / CUSTOM_API_KEY / CUSTOM_MODEL

# Object store (MinIO/S3-compatible) for uploaded project canonicals.
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=projects
# MinIO/local only. Leave unset or false for AWS S3 (virtual-hosted style).
OBJECT_STORE_FORCE_PATH_STYLE=true

# Project settings
PROJECT_UPLOAD_MAX_MB=800

# Session Docker sandbox (Node + git + global Playwright for web_fetch).
# Built automatically on first session if missing; or build explicitly:
#   pnpm docker:sandbox
# Use forge-sandbox:latest (not mcr.microsoft.com/playwright) — the Microsoft
# image lacks our NODE_PATH Playwright layout and used to trigger a slow
# npm install on every tool/apps poll, freezing Files / Run / Changes.
FORGE_SANDBOX_IMAGE=forge-sandbox:latest

# SandboxRuntime adapter: docker (local/default) | kubernetes (kind/EKS).
# SANDBOX_RUNTIME=docker
# FORGE_SANDBOX_NAMESPACE=forge
# Preview host zone under the product domain (kind: preview.forge.local).
# FORGE_PREVIEW_BASE_DOMAIN=preview.forge.local
# PREVIEW_URL_SCHEME=http
# Preview-plane base URL for register/revoke (cluster service DNS in k8s).
# PREVIEW_PLANE_URL=http://127.0.0.1:8081

# ---- Agent web_search / web_fetch (default off) ----
# When WEB_TOOLS_ENABLED=1, chat Plan/Build and pipeline agents with tools get
# web_search (warm Docker worker pool) and web_fetch (Playwright in session sandbox).
WEB_TOOLS_ENABLED=0
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_BASE_URL=
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_MIN_WARM=1
# WEB_SEARCH_MAX_WORKERS=5
# WEB_SEARCH_TARGET_LATENCY_MS=8000
# Optional image for long-lived search workers (default: node:20-alpine).
# WEB_SEARCH_WORKER_IMAGE=node:20-alpine

# Optional: GitHub OAuth (repo picker). Leave unset for chat-only local use.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:4000/api/github/oauth/callback
# FORGE_WEB_UI_ORIGIN=http://127.0.0.1:5173
# GITHUB_OAUTH_STATE_SECRET=

# ---- Temporal orchestration (board pipelines + interactive chat turns) ----
# Master switch for board→pipeline workflows. Interactive chat always uses Temporal
# when the worker is running. Legacy alias: SDLC_ORCHESTRATION_ENABLED.
WORKFLOW_ORCHESTRATION_ENABLED=false
# Local Temporal (docker compose up -d temporal, or pnpm temporal:dev). Web UI at http://localhost:8233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=forge-orchestrator
# Persona LLM for board pipeline stage activities (falls back to ANTHROPIC_/OPENAI_/OPENAI_COMPATIBLE_*).
#   WORKFLOW_LLM_PROVIDER = anthropic | openai | openai-compatible
# Legacy aliases: SDLC_LLM_PROVIDER / SDLC_LLM_BASE_URL / SDLC_LLM_MODEL / SDLC_LLM_API_KEY
# WORKFLOW_LLM_PROVIDER=openai-compatible
# WORKFLOW_LLM_MODEL=your-local-model

# Interactive chat Temporal timeouts (hardcoded in workflow; for reference):
#   provider=openai-compatible → LLM activity start-to-close 45m, heartbeat 5m
#   provider=openai|anthropic → 15m / 2m
# Restart the orchestrator worker after pulling timeout changes.

# Workflow + agent definitions: system-provided ones ship in
# packages/workflows/definitions/ and packages/agents/definitions/. Per-user
# overrides (not in the repo) are resolved from <root>/<userId>/<id>.yaml.
# FORGE_USER_WORKFLOWS_ROOT=~/.forge/workflows
# FORGE_USER_AGENTS_ROOT=~/.forge/agents
